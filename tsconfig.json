{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "checks/*.mts", "examples/*.mts", "measure/*.mts", "surveys/*.mts", "tools/*.mts", "vitest.config.mts", "vitest.mutants.mts", "type-tests/*.ts"]
}
