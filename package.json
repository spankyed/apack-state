{
  "name": "@apackdev/state",
  "version": "0.1.0",
  "description": "States that reach each other by name, across a backend and its windows: one primitive, steps that are kept whole or not at all, and every ordering checked.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    }
  },
  "bin": {
    "apack-state-graph": "./bin/apack-state-graph.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-state.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p type-tests/vue-templates/tsconfig.json",
    "test": "vitest run --project node",
    "measure": "node scripts/bench.mjs",
    "test:watch": "vitest --project node",
    "api:check": "node scripts/api.mjs",
    "api:update": "node scripts/api.mjs --local",
    "typecheck:floor": "node node_modules/typescript-5.7/bin/tsc --noEmit -p tsconfig.json",
    "mutants": "stryker run",
    "mutants:list": "node scripts/mutants-list.mjs",
    "mutants:merge-install": "node scripts/mutants-merge.mjs --install",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "workflows:check": "node scripts/workflows-check.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "deps:pin": "node scripts/deps.mjs pin",
    "deps:local": "node scripts/deps.mjs local",
    "deps:released": "node scripts/deps.mjs released",
    "deps:check": "node scripts/deps.mjs check",
    "lint": "oxlint --deny-warnings src bin checks examples measure surveys tools scripts type-tests stryker.config.mjs vitest.config.mts vitest.mutants.mts",
    "package:lint": "node scripts/package-lint.mjs",
    "test:browser": "vitest run --project browser",
    "bench": "node scripts/bench.mjs",
    "bench:record": "node scripts/bench.mjs --record",
    "graph:update": "tsx tools/graph.mts --write",
    "graph:check": "tsx tools/graph.mts --check",
    "errors:update": "node scripts/errors.mjs --write",
    "errors:check": "node scripts/errors.mjs",
    "pre-push": "node scripts/pre-push.mjs",
    "hooks:install": "node scripts/hooks-install.mjs"
  },
  "peerDependencies": {
    "@apackdev/link": "*",
    "@apackdev/orderings": "*",
    "@vue/reactivity": "^3.5.0",
    "@vue/runtime-core": "^3.5.0",
    "typescript": ">=5.7.0"
  },
  "peerDependenciesMeta": {
    "@apackdev/link": {
      "optional": true
    },
    "@apackdev/orderings": {
      "optional": true
    },
    "@vue/reactivity": {
      "optional": true
    },
    "@vue/runtime-core": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apackdev/link": "https://github.com/spankyed/apack-link/releases/download/pkg-51a406fc27e9e7bd11ac1eb7ca6995e73f1eef55/apackdev-link-0.1.0.tgz",
    "@apackdev/orderings": "https://github.com/spankyed/apack-orderings/releases/download/pkg-65dda86e8e69679dd420ed32d8c3b5df171cbe2c/apackdev-orderings-0.1.0.tgz",
    "@arethetypeswrong/cli": "^0.18.5",
    "@elmdb/ears": "https://github.com/spankyed/elmdb/releases/download/pkg-9aafb09b2a9870d882c584ca99634d6fbf5b1b01/elmdb-ears-0.1.0.tgz",
    "@microsoft/api-extractor": "^7.60.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/reactivity": "^3.5.0",
    "@vue/runtime-core": "^3.5.0",
    "assert": "^2.1.0",
    "elmdb": "https://github.com/spankyed/elmdb/releases/download/pkg-9aafb09b2a9870d882c584ca99634d6fbf5b1b01/elmdb-0.1.0.tgz",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-5.7": "npm:typescript@~5.7.3",
    "vitest": "^4.1.12",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
